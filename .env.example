# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive maps, prospect geolocation, and territory mapping.
VITE_GOOGLE_MAPS_API_KEY="AIzaSyCESzxO08ZD8lbuU7i3cTC15piWf_NTQ5U"

# OWNER_EMAILS: comma-separated Master Admin emails for the server owner gate.
# Phase 0: there are NO hardcoded owners. Unset/empty = owner routes fail closed (403).
OWNER_EMAILS=""

# BRIEFING_RECIPIENT_EMAIL: default recipient for the daily scheduler briefing.
# Unset = scheduler reports not_configured instead of emailing anyone.
BRIEFING_RECIPIENT_EMAIL=""

# FIREBASE_PROJECT_ID: expected aud/iss for Firebase ID tokens.
# Defaults to the projectId in firebase-applet-config.json.
FIREBASE_PROJECT_ID=""

# DEMO_MODE: when "true", /api/leads/scrape returns labeled demo data
# (simulated: true on every record). Any other value = live behavior only.
DEMO_MODE=""

# AI_DAILY_QUOTA_PER_USER: per-user daily cap on Gemini-backed routes (default 200).
AI_DAILY_QUOTA_PER_USER=""

# TRUST_PROXY: set "true" ONLY behind a known reverse proxy so the rate
# limiter may honor X-Forwarded-For. Otherwise client XFF is ignored.
TRUST_PROXY=""
